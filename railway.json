{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": ["backend/**", "db/migrations/**", "src/catalog/**", "railpack.json", "railway.json"]
  },
  "deploy": {
    "startCommand": "java -jar target/app.jar --spring.profiles.active=production",
    "healthcheckPath": "/api/auth/session",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
